{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CricAPI Response",
  "description": "Schema for the CricAPI REST API response envelope",
  "type": "object",
  "properties": {
    "apiid": { "type": "string" },
    "status": { "type": "string" },
    "data": {
      "type": "object",
      "description": "Match-specific data payload",
      "properties": {
        "id":         { "type": "string" },
        "name":       { "type": "string" },
        "matchType":  { "type": "string" },
        "status":     { "type": "string" },
        "venue":      { "type": "string" },
        "teams":      { "type": "array", "items": { "type": "string" } },
        "tossWinner": { "type": "string" },
        "tossChoice": { "type": "string" },
        "score": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "r":   { "type": "integer" },
              "w":   { "type": "integer" },
              "o":   { "type": "number" },
              "inning": { "type": "string" }
            }
          }
        },
        "scorecard": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  }
}
