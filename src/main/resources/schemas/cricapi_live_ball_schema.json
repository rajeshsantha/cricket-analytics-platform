{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CricAPI Live Ball Event",
  "description": "Schema for a single ball delivery event from CricAPI",
  "type": "object",
  "required": ["matchId", "eventTime"],
  "properties": {
    "matchId": {
      "type": "string",
      "description": "Unique match identifier"
    },
    "inning": {
      "type": "string",
      "description": "Innings description, e.g. '1st Innings'"
    },
    "over": {
      "type": "integer",
      "description": "Over number (0-indexed)",
      "minimum": 0
    },
    "ball": {
      "type": "integer",
      "description": "Ball number within the over",
      "minimum": 1
    },
    "batsman": {
      "type": "string",
      "description": "Batsman facing the delivery"
    },
    "bowler": {
      "type": "string",
      "description": "Bowler delivering the ball"
    },
    "runs": {
      "type": "object",
      "properties": {
        "batsman": { "type": "integer", "minimum": 0 },
        "extras":  { "type": "integer", "minimum": 0 },
        "total":   { "type": "integer", "minimum": 0 }
      }
    },
    "wicket": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "kind":       { "type": "string" },
            "player_out": { "type": "string" }
          }
        }
      ]
    },
    "eventTime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the ball event"
    }
  }
}
